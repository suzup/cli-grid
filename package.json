{
  "name": "agentry",
  "displayName": "Agentry",
  "description": "Run Claude Code, Codex and Gemini CLI side by side, configured per folder, with your files and git beside them.",
  "version": "0.1.0",
  "publisher": "suzup",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "gemini cli",
    "terminal",
    "agent",
    "multi-agent"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzup/agentry.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.vscode/agentry.json"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "agentry.initProject",
        "title": "%cmd.initProject%",
        "category": "Agentry",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentry.newAgent",
        "title": "%cmd.newAgent%",
        "category": "Agentry",
        "icon": "$(add)"
      },
      {
        "command": "agentry.startAgent",
        "title": "%cmd.startAgent%",
        "category": "Agentry",
        "icon": "$(debug-start)"
      },
      {
        "command": "agentry.startAll",
        "title": "%cmd.startAll%",
        "category": "Agentry",
        "icon": "$(run-all)"
      },
      {
        "command": "agentry.stopAgent",
        "title": "%cmd.stopAgent%",
        "category": "Agentry",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentry.restartAgent",
        "title": "%cmd.restartAgent%",
        "category": "Agentry",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentry.saveAgent",
        "title": "%cmd.saveAgent%",
        "category": "Agentry",
        "icon": "$(save)"
      },
      {
        "command": "agentry.removeAgent",
        "title": "%cmd.removeAgent%",
        "category": "Agentry",
        "icon": "$(trash)"
      },
      {
        "command": "agentry.openConfig",
        "title": "%cmd.openConfig%",
        "category": "Agentry",
        "icon": "$(json)"
      },
      {
        "command": "agentry.focusAgent",
        "title": "%cmd.focusAgent%",
        "category": "Agentry"
      },
      {
        "command": "agentry.showAgents",
        "title": "%cmd.showAgents%",
        "category": "Agentry",
        "icon": "$(zap)"
      },
      {
        "command": "agentry.refresh",
        "title": "%cmd.refresh%",
        "category": "Agentry",
        "icon": "$(refresh)"
      },
      {
        "command": "agentry.applyLayout",
        "title": "%cmd.applyLayout%",
        "category": "Agentry"
      },
      {
        "command": "agentry.toggleHiddenFiles",
        "title": "%cmd.toggleHiddenFiles%",
        "category": "Agentry",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentry.startAgent",
          "when": "false"
        },
        {
          "command": "agentry.stopAgent",
          "when": "false"
        },
        {
          "command": "agentry.restartAgent",
          "when": "false"
        },
        {
          "command": "agentry.saveAgent",
          "when": "false"
        },
        {
          "command": "agentry.removeAgent",
          "when": "false"
        },
        {
          "command": "agentry.focusAgent",
          "when": "false"
        },
        {
          "command": "agentry.applyLayout",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentry.initProject",
          "when": "view == agentry.agents && !agentry.isProject && workbenchState != empty",
          "group": "navigation@1"
        },
        {
          "command": "agentry.newAgent",
          "when": "view == agentry.agents && agentry.isProject",
          "group": "navigation@1"
        },
        {
          "command": "agentry.refresh",
          "when": "view == agentry.agents",
          "group": "1_config@2"
        },
        {
          "command": "agentry.openConfig",
          "when": "view == agentry.agents && agentry.isProject",
          "group": "1_config@1"
        },
        {
          "command": "agentry.toggleHiddenFiles",
          "when": "view == agentry.files",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentry.newAgent",
          "when": "view == agentry.agents && viewItem == agentry.project",
          "group": "inline@1"
        },
        {
          "command": "agentry.startAll",
          "when": "view == agentry.agents && viewItem == agentry.project",
          "group": "inline@2"
        },
        {
          "command": "agentry.openConfig",
          "when": "view == agentry.agents && viewItem == agentry.project",
          "group": "1_config@1"
        },
        {
          "command": "agentry.startAgent",
          "when": "view == agentry.agents && viewItem == agentry.agent.stopped",
          "group": "inline@1"
        },
        {
          "command": "agentry.restartAgent",
          "when": "view == agentry.agents && viewItem =~ /^agentry\\.agent\\.running/",
          "group": "inline@1"
        },
        {
          "command": "agentry.stopAgent",
          "when": "view == agentry.agents && viewItem =~ /^agentry\\.agent\\.running/",
          "group": "inline@2"
        },
        {
          "command": "agentry.saveAgent",
          "when": "view == agentry.agents && viewItem == agentry.agent.running.adhoc",
          "group": "inline@3"
        },
        {
          "command": "agentry.removeAgent",
          "when": "view == agentry.agents && viewItem =~ /^agentry\\.agent/",
          "group": "9_danger@1"
        }
      ]
    },
    "views": {
      "agentry": [
        {
          "id": "agentry.agents",
          "name": "%view.agents%",
          "contextualTitle": "Agentry",
          "visibility": "visible",
          "initialSize": 2
        },
        {
          "id": "agentry.files",
          "name": "%view.files%",
          "contextualTitle": "Agentry",
          "visibility": "visible",
          "initialSize": 5
        },
        {
          "id": "agentry.layout",
          "name": "%view.layout%",
          "contextualTitle": "Agentry",
          "visibility": "visible",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentry.agents",
        "when": "workbenchState == empty",
        "contents": "%welcome.noFolder%"
      },
      {
        "view": "agentry.agents",
        "when": "workbenchState != empty && !agentry.isProject",
        "contents": "%welcome.notProject%"
      },
      {
        "view": "agentry.agents",
        "when": "workbenchState != empty && agentry.isProject",
        "contents": "%welcome.noAgents%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/agentry.json",
        "url": "./schema/agentry.schema.json"
      }
    ],
    "configuration": {
      "title": "Agentry",
      "properties": {
        "agentry.defaultMode": {
          "type": "string",
          "enum": [
            "new",
            "resume"
          ],
          "enumDescriptions": [
            "%config.defaultMode.new%",
            "%config.defaultMode.resume%"
          ],
          "default": "new",
          "markdownDescription": "%config.defaultMode%"
        },
        "agentry.launchStrategy": {
          "type": "string",
          "enum": [
            "shell",
            "exec"
          ],
          "enumDescriptions": [
            "%config.launchStrategy.shell%",
            "%config.launchStrategy.exec%"
          ],
          "default": "shell",
          "markdownDescription": "%config.launchStrategy%"
        },
        "agentry.autoStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoStart%"
        },
        "agentry.revealOnFocus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.revealOnFocus%"
        },
        "agentry.profiles": {
          "type": "object",
          "scope": "window",
          "markdownDescription": "%config.profiles%",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "properties": {
                  "new": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resume": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "defaultMode": {
                "type": "string",
                "enum": [
                  "new",
                  "resume"
                ]
              },
              "icon": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        },
        "agentry.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showHiddenFiles%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "agentry.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openFolder",
            "title": "%walkthrough.step1.title%",
            "description": "%walkthrough.step1.description%",
            "media": {
              "markdown": "media/walkthrough-folder.md"
            }
          },
          {
            "id": "launchAgent",
            "title": "%walkthrough.step2.title%",
            "description": "%walkthrough.step2.description%",
            "media": {
              "markdown": "media/walkthrough-agent.md"
            },
            "completionEvents": [
              "onCommand:agentry.newAgent"
            ]
          },
          {
            "id": "arrange",
            "title": "%walkthrough.step3.title%",
            "description": "%walkthrough.step3.description%",
            "media": {
              "markdown": "media/walkthrough-layout.md"
            },
            "completionEvents": [
              "onCommand:agentry.applyLayout"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentry",
          "title": "Agentry",
          "icon": "media/agentry.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "bugs": {
    "url": "https://github.com/suzup/agentry/issues"
  },
  "homepage": "https://github.com/suzup/agentry#readme"
}
