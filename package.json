{
  "name": "cli-grid",
  "displayName": "CLI Grid — multi-agent Claude Code, Codex, Gemini",
  "description": "Run several agent CLIs side by side in VS Code, configured per folder. No tmux, no extra window, with each agent's files and git beside it.",
  "version": "0.1.0",
  "publisher": "suzup",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "gemini cli",
    "multi agent",
    "multi-agent",
    "agent",
    "terminal",
    "split terminal",
    "cli",
    "tmux alternative"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzup/cli-grid.git"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.vscode/cli-grid.json",
    "workspaceContains:.vscode/agent-grid.json",
    "workspaceContains:.vscode/agentry.json"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "cliGrid.initProject",
        "title": "%cmd.initProject%",
        "category": "CLI Grid",
        "icon": "$(new-folder)"
      },
      {
        "command": "cliGrid.newAgent",
        "title": "%cmd.newAgent%",
        "category": "CLI Grid",
        "icon": "$(add)"
      },
      {
        "command": "cliGrid.startAgent",
        "title": "%cmd.startAgent%",
        "category": "CLI Grid",
        "icon": "$(debug-start)"
      },
      {
        "command": "cliGrid.startAll",
        "title": "%cmd.startAll%",
        "category": "CLI Grid",
        "icon": "$(run-all)"
      },
      {
        "command": "cliGrid.startAllResumed",
        "title": "%cmd.startAllResumed%",
        "category": "CLI Grid",
        "icon": "$(history)"
      },
      {
        "command": "cliGrid.startResumed",
        "title": "%cmd.startResumed%",
        "category": "CLI Grid",
        "icon": "$(history)"
      },
      {
        "command": "cliGrid.startFresh",
        "title": "%cmd.startFresh%",
        "category": "CLI Grid",
        "icon": "$(add)"
      },
      {
        "command": "cliGrid.stopAgent",
        "title": "%cmd.stopAgent%",
        "category": "CLI Grid",
        "icon": "$(debug-stop)"
      },
      {
        "command": "cliGrid.restartAgent",
        "title": "%cmd.restartAgent%",
        "category": "CLI Grid",
        "icon": "$(debug-restart)"
      },
      {
        "command": "cliGrid.saveAgent",
        "title": "%cmd.saveAgent%",
        "category": "CLI Grid",
        "icon": "$(save)"
      },
      {
        "command": "cliGrid.removeAgent",
        "title": "%cmd.removeAgent%",
        "category": "CLI Grid",
        "icon": "$(trash)"
      },
      {
        "command": "cliGrid.openConfig",
        "title": "%cmd.openConfig%",
        "category": "CLI Grid",
        "icon": "$(json)"
      },
      {
        "command": "cliGrid.focusAgent",
        "title": "%cmd.focusAgent%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.showAgents",
        "title": "%cmd.showAgents%",
        "category": "CLI Grid",
        "icon": "$(zap)"
      },
      {
        "command": "cliGrid.refresh",
        "title": "%cmd.refresh%",
        "category": "CLI Grid",
        "icon": "$(refresh)"
      },
      {
        "command": "cliGrid.applyLayout",
        "title": "%cmd.applyLayout%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.toggleHiddenFiles",
        "title": "%cmd.toggleHiddenFiles%",
        "category": "CLI Grid",
        "icon": "$(eye)"
      },
      {
        "command": "cliGrid.openFile",
        "title": "%cmd.openFile%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.newFile",
        "title": "%cmd.newFile%",
        "category": "CLI Grid",
        "icon": "$(new-file)"
      },
      {
        "command": "cliGrid.newFolder",
        "title": "%cmd.newFolder%",
        "category": "CLI Grid",
        "icon": "$(new-folder)"
      },
      {
        "command": "cliGrid.rename",
        "title": "%cmd.rename%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.delete",
        "title": "%cmd.delete%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.copy",
        "title": "%cmd.copy%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.cut",
        "title": "%cmd.cut%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.paste",
        "title": "%cmd.paste%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.copyPath",
        "title": "%cmd.copyPath%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.copyRelativePath",
        "title": "%cmd.copyRelativePath%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.revealInOS",
        "title": "%cmd.revealInOS%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.revealInExplorer",
        "title": "%cmd.revealInExplorer%",
        "category": "CLI Grid"
      },
      {
        "command": "cliGrid.openInTerminal",
        "title": "%cmd.openInTerminal%",
        "category": "CLI Grid"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cliGrid.startAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.stopAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.restartAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.saveAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.removeAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.focusAgent",
          "when": "false"
        },
        {
          "command": "cliGrid.applyLayout",
          "when": "false"
        },
        {
          "command": "cliGrid.startResumed",
          "when": "false"
        },
        {
          "command": "cliGrid.startFresh",
          "when": "false"
        },
        {
          "command": "cliGrid.startAllResumed",
          "when": "false"
        },
        {
          "command": "cliGrid.openFile",
          "when": "false"
        },
        {
          "command": "cliGrid.newFile",
          "when": "false"
        },
        {
          "command": "cliGrid.newFolder",
          "when": "false"
        },
        {
          "command": "cliGrid.rename",
          "when": "false"
        },
        {
          "command": "cliGrid.delete",
          "when": "false"
        },
        {
          "command": "cliGrid.copy",
          "when": "false"
        },
        {
          "command": "cliGrid.cut",
          "when": "false"
        },
        {
          "command": "cliGrid.paste",
          "when": "false"
        },
        {
          "command": "cliGrid.copyPath",
          "when": "false"
        },
        {
          "command": "cliGrid.copyRelativePath",
          "when": "false"
        },
        {
          "command": "cliGrid.revealInOS",
          "when": "false"
        },
        {
          "command": "cliGrid.revealInExplorer",
          "when": "false"
        },
        {
          "command": "cliGrid.openInTerminal",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "cliGrid.initProject",
          "when": "view == cliGrid.agents && !cliGrid.isProject && workbenchState != empty",
          "group": "navigation@1"
        },
        {
          "command": "cliGrid.newAgent",
          "when": "view == cliGrid.agents && cliGrid.isProject",
          "group": "navigation@1"
        },
        {
          "command": "cliGrid.startAll",
          "when": "view == cliGrid.agents && cliGrid.isProject",
          "group": "navigation@2"
        },
        {
          "command": "cliGrid.startAllResumed",
          "when": "view == cliGrid.agents && cliGrid.isProject",
          "group": "navigation@3"
        },
        {
          "command": "cliGrid.openConfig",
          "when": "view == cliGrid.agents && cliGrid.isProject",
          "group": "1_config@1"
        },
        {
          "command": "cliGrid.refresh",
          "when": "view == cliGrid.agents",
          "group": "1_config@2"
        },
        {
          "command": "cliGrid.toggleHiddenFiles",
          "when": "view == cliGrid.files",
          "group": "navigation@1"
        },
        {
          "command": "cliGrid.newFile",
          "when": "view == cliGrid.files",
          "group": "navigation@2"
        },
        {
          "command": "cliGrid.newFolder",
          "when": "view == cliGrid.files",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "cliGrid.newAgent",
          "when": "view == cliGrid.agents && viewItem == cliGrid.project",
          "group": "inline@1"
        },
        {
          "command": "cliGrid.startAll",
          "when": "view == cliGrid.agents && viewItem == cliGrid.project",
          "group": "inline@2"
        },
        {
          "command": "cliGrid.startAllResumed",
          "when": "view == cliGrid.agents && viewItem == cliGrid.project",
          "group": "inline@3"
        },
        {
          "command": "cliGrid.openConfig",
          "when": "view == cliGrid.agents && viewItem == cliGrid.project",
          "group": "1_config@1"
        },
        {
          "command": "cliGrid.startAgent",
          "when": "view == cliGrid.agents && viewItem =~ /^cliGrid\\.agent\\.stopped/",
          "group": "inline@1"
        },
        {
          "command": "cliGrid.startResumed",
          "when": "view == cliGrid.agents && viewItem == cliGrid.agent.stopped.new",
          "group": "inline@2"
        },
        {
          "command": "cliGrid.startFresh",
          "when": "view == cliGrid.agents && viewItem == cliGrid.agent.stopped.resume",
          "group": "inline@2"
        },
        {
          "command": "cliGrid.restartAgent",
          "when": "view == cliGrid.agents && viewItem =~ /^cliGrid\\.agent\\.running/",
          "group": "inline@1"
        },
        {
          "command": "cliGrid.stopAgent",
          "when": "view == cliGrid.agents && viewItem =~ /^cliGrid\\.agent\\.running/",
          "group": "inline@2"
        },
        {
          "command": "cliGrid.saveAgent",
          "when": "view == cliGrid.agents && viewItem == cliGrid.agent.running.adhoc",
          "group": "inline@3"
        },
        {
          "command": "cliGrid.removeAgent",
          "when": "view == cliGrid.agents && viewItem =~ /^cliGrid\\.agent/",
          "group": "9_danger@1"
        },
        {
          "command": "cliGrid.newFile",
          "when": "view == cliGrid.files && viewItem == cliGrid.dir",
          "group": "1_new@1"
        },
        {
          "command": "cliGrid.newFolder",
          "when": "view == cliGrid.files && viewItem == cliGrid.dir",
          "group": "1_new@2"
        },
        {
          "command": "cliGrid.revealInOS",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "2_workspace@1"
        },
        {
          "command": "cliGrid.revealInExplorer",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "2_workspace@2"
        },
        {
          "command": "cliGrid.openInTerminal",
          "when": "view == cliGrid.files && viewItem == cliGrid.dir",
          "group": "2_workspace@3"
        },
        {
          "command": "cliGrid.cut",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "cliGrid.copy",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "cliGrid.paste",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "cliGrid.copyPath",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "6_copypath@1"
        },
        {
          "command": "cliGrid.copyRelativePath",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "6_copypath@2"
        },
        {
          "command": "cliGrid.rename",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "7_modification@1"
        },
        {
          "command": "cliGrid.delete",
          "when": "view == cliGrid.files && viewItem =~ /^cliGrid\\.(file|dir)$/",
          "group": "7_modification@2"
        }
      ]
    },
    "views": {
      "cliGrid": [
        {
          "id": "cliGrid.agents",
          "name": "%view.agents%",
          "contextualTitle": "CLI Grid",
          "visibility": "visible",
          "initialSize": 2
        },
        {
          "id": "cliGrid.files",
          "name": "%view.files%",
          "contextualTitle": "CLI Grid",
          "visibility": "visible",
          "initialSize": 5
        },
        {
          "id": "cliGrid.layout",
          "name": "%view.layout%",
          "contextualTitle": "CLI Grid",
          "visibility": "visible",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cliGrid.agents",
        "when": "workbenchState == empty",
        "contents": "%welcome.noFolder%"
      },
      {
        "view": "cliGrid.agents",
        "when": "workbenchState != empty && !cliGrid.isProject",
        "contents": "%welcome.notProject%"
      },
      {
        "view": "cliGrid.agents",
        "when": "workbenchState != empty && cliGrid.isProject",
        "contents": "%welcome.noAgents%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/cli-grid.json",
        "url": "./schema/cli-grid.schema.json"
      }
    ],
    "configuration": {
      "title": "CLI Grid",
      "properties": {
        "cliGrid.defaultMode": {
          "type": "string",
          "enum": [
            "new",
            "resume"
          ],
          "enumDescriptions": [
            "%config.defaultMode.new%",
            "%config.defaultMode.resume%"
          ],
          "default": "new",
          "markdownDescription": "%config.defaultMode%"
        },
        "cliGrid.launchStrategy": {
          "type": "string",
          "enum": [
            "shell",
            "exec"
          ],
          "enumDescriptions": [
            "%config.launchStrategy.shell%",
            "%config.launchStrategy.exec%"
          ],
          "default": "shell",
          "markdownDescription": "%config.launchStrategy%"
        },
        "cliGrid.autoStart": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.autoStart%"
        },
        "cliGrid.revealOnFocus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.revealOnFocus%"
        },
        "cliGrid.profiles": {
          "type": "object",
          "scope": "window",
          "markdownDescription": "%config.profiles%",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "properties": {
                  "new": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "resume": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "defaultMode": {
                "type": "string",
                "enum": [
                  "new",
                  "resume"
                ]
              },
              "icon": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        },
        "cliGrid.showHiddenFiles": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.showHiddenFiles%"
        },
        "cliGrid.lockAgentPanes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.lockAgentPanes%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "cliGrid.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openFolder",
            "title": "%walkthrough.step1.title%",
            "description": "%walkthrough.step1.description%",
            "media": {
              "markdown": "media/walkthrough-folder.md"
            }
          },
          {
            "id": "launchAgent",
            "title": "%walkthrough.step2.title%",
            "description": "%walkthrough.step2.description%",
            "media": {
              "markdown": "media/walkthrough-agent.md"
            },
            "completionEvents": [
              "onCommand:cliGrid.newAgent"
            ]
          },
          {
            "id": "arrange",
            "title": "%walkthrough.step3.title%",
            "description": "%walkthrough.step3.description%",
            "media": {
              "markdown": "media/walkthrough-layout.md"
            },
            "completionEvents": [
              "onCommand:cliGrid.applyLayout"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cliGrid",
          "title": "CLI Grid",
          "icon": "media/cli-grid.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cliGrid.rename",
        "key": "f2",
        "when": "focusedView == cliGrid.files"
      },
      {
        "command": "cliGrid.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == cliGrid.files"
      },
      {
        "command": "cliGrid.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == cliGrid.files"
      },
      {
        "command": "cliGrid.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == cliGrid.files"
      },
      {
        "command": "cliGrid.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == cliGrid.files"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "reinstall": "npm run build && vsce package --no-dependencies -o cli-grid.vsix && code --install-extension cli-grid.vsix --force"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vscode-uri": "^3.1.0"
  },
  "bugs": {
    "url": "https://github.com/suzup/cli-grid/issues"
  },
  "homepage": "https://github.com/suzup/cli-grid#readme"
}
